---
import { getPosts, slugOf, findTranslation } from '../../lib/posts';
import { CATEGORIES, UI } from '../../i18n';

export async function getStaticPaths() {
  const posts = await getPosts('zh');
  return posts.map((post) => ({ params: { slug: slugOf(post) }, props: { post } }));
}

import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import type { Lang } from '../../i18n';

const lang: Lang = 'zh';
const { post } = Astro.props;
const { Content } = await render(post);
const slug = slugOf(post);
const translation = await findTranslation(lang, slug);
const alternateUrl = translation ? `/en/article/${slug}/` : '/en/';
const cat = CATEGORIES[post.data.category as keyof typeof CATEGORIES];
const t = UI[lang];
const related = (await getPosts(lang))
  .filter((p) => p.data.category === post.data.category && slugOf(p) !== slug)
  .slice(0, 3);
---
<Base lang={lang} title={`${post.data.title} | Felix 出海营销实战笔记`} description={post.data.excerpt} alternateUrl={alternateUrl}>
  <article>
    <header class="article-head">
      <div class="post-meta">
        <span class="cat">{cat?.zh}</span>
        <time datetime={post.data.date.toISOString().slice(0, 10)}>{post.data.date.toISOString().slice(0, 10)}</time>
        {post.data.minutes && <span> · {post.data.minutes} {t.minRead}</span>}
        {post.data.updated && <span> · {t.updated} {post.data.updated.toISOString().slice(0, 10)}</span>}
      </div>
      <h1>{post.data.title}</h1>
    </header>
    <div class="prose">
      <Content />
    </div>
  </article>
  {related.length > 0 && (
    <section class="section">
      <div class="section-head"><span class="num">→</span><h2>{t.related}</h2></div>
      {related.map((p) => (
        <a class="post-row" href={`/article/${slugOf(p)}/`}>
          <div class="post-meta">
            <span class="cat">{CATEGORIES[p.data.category as keyof typeof CATEGORIES].zh}</span>
            <time datetime={p.data.date.toISOString().slice(0, 10)}>{p.data.date.toISOString().slice(0, 10)}</time>
          </div>
          <h3>{p.data.title}</h3>
        </a>
      ))}
    </section>
  )}
  <script type="application/ld+json" set:html={JSON.stringify({
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: post.data.title,
    description: post.data.excerpt,
    datePublished: post.data.date.toISOString().slice(0, 10),
    inLanguage: 'zh-CN',
    author: { '@type': 'Person', name: 'Felix', url: 'https://felixseo.com/about/' },
    mainEntityOfPage: `https://felixseo.com/article/${slug}/`,
  })} />
</Base>
