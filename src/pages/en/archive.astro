---
import Base from '../../layouts/Base.astro';
import PostList from '../../components/PostList.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts('en');
---
<Base lang="en" title="All Articles | Felix's Field Notes" description="All field notes on B2B go-global SEO, GEO, independent sites, ads and social.">
  <section class="hero">
    <div class="kicker">Archive</div>
    <h1>All Articles</h1>
    <p class="lede">{posts.length} articles, newest first.</p>
  </section>
  <section class="section">
    <PostList lang="en" posts={posts} withExcerpt={false} />
  </section>
</Base>
