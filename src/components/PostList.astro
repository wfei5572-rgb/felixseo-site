---
import { getCollection } from 'astro:content';
import { CATEGORIES, UI } from '../i18n';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
  posts: any[];
  /** 是否带摘要 */
  withExcerpt?: boolean;
}
const { lang, posts, withExcerpt = true } = Astro.props;
const t = UI[lang];
const prefix = lang === 'zh' ? '' : '/en';
---
{posts.map((p) => {
  const cat = CATEGORIES[p.data.category as keyof typeof CATEGORIES];
  return (
    <a class="post-row" href={`${prefix}/article/${p.id.split('/').pop()?.replace(/\.md$/, '')}/`}>
      <div class="post-meta">
        <span class="cat">{cat?.[lang] ?? p.data.category}</span>
        <time datetime={p.data.date.toISOString().slice(0, 10)}>
          {p.data.date.toISOString().slice(0, 10)}
        </time>
        {p.data.minutes && <span> · {p.data.minutes} {t.minRead}</span>}
      </div>
      <h3>{p.data.title}</h3>
      {withExcerpt && p.data.excerpt && <p class="excerpt">{p.data.excerpt}</p>}
    </a>
  );
})}
