---
import '../styles/global.css';
import { UI, CATEGORIES } from '../i18n';
import type { Lang } from '../i18n';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** 另一语言的同内容 URL（用于 hreflang 和语言切换） */
  alternateUrl?: string;
}
const { lang, title, description, alternateUrl } = Astro.props;
const t = UI[lang];
const base = Astro.site ?? new URL('https://felixseo.com');
const canonical = new URL(Astro.url.pathname, base).href;
const zhUrl = lang === 'zh' ? canonical : alternateUrl ? new URL(alternateUrl, base).href : canonical;
const enUrl = lang === 'en' ? canonical : alternateUrl ? new URL(alternateUrl, base).href : new URL('/en' + Astro.url.pathname, base).href;
const home = lang === 'zh' ? '/' : '/en/';
const articles = lang === 'zh' ? '/archive/' : '/en/archive/';
const about = lang === 'zh' ? '/about/' : '/en/about/';
const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' || href === '/en/' ? path === href : path.startsWith(href.replace(/\/$/, ''));
---
<!doctype html>
<html lang={lang === 'zh' ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonical} />
    <link rel="alternate" hreflang="zh-CN" href={zhUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={zhUrl} />
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='20' fill='%23e8590c'/><text x='50' y='68' font-size='55' text-anchor='middle' fill='white' font-family='sans-serif' font-weight='bold'>F</text></svg>" />
  </head>
  <body>
    <header class="topbar">
      <div class="wrap">
        <a class="brand" href={home}>Felix<span>.</span>Notes</a>
        <nav class="site">
          <a href={articles} class={isActive(articles) ? 'active' : ''}>{t.articles}</a>
          <a href={about} class={isActive(about) ? 'active' : ''}>{t.about}</a>
          <a href={lang === 'zh' ? enUrl : zhUrl}>{t.language}</a>
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="site">
      <div class="wrap">
        <span>© {new Date().getFullYear()} Felix · {lang === 'zh' ? '保留所有权利' : 'All rights reserved'}</span>
        <span>{lang === 'zh' ? 'Built with Astro · Deployed on Cloudflare Pages' : 'Built with Astro · Deployed on Cloudflare Pages'}</span>
      </div>
    </footer>
  </body>
</html>
